{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z]{4}$/)",

        "state": {
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(attente|question|resultats|migration|rdv|fin)$/)" },
          "qId": { ".validate": "newData.isNumber()" },
          "migration": { ".validate": "newData.isString() && newData.val() == 'mazal'" },
          "ecartAge": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
          "qNum": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "rdvNum": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
          "tourLanceA": { ".validate": "newData.isNumber()" },
          "phaseAt": { ".validate": "newData.isNumber()" },
          "dureeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "msgEcran": {
            "texte": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "at": { ".validate": "newData.isNumber()" },
            "$autre": { ".validate": false }
          },
          "q": {
            "id": { ".validate": "newData.isNumber()" },
            "texte": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "choix": {
              "$i": {
                "texte": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "coin": { ".validate": "newData.isString() && (newData.val() == 'א' || newData.val() == 'ב' || newData.val() == 'ג' || newData.val() == 'ד')" },
                "$autre": { ".validate": false }
              }
            },
            "$autre": { ".validate": false }
          },
          "$autre": { ".validate": false }
        },

        "participants": {
          "$badge": {
            ".validate": "$badge.matches(/^[0-9]{1,4}$/)",
            "genre": { ".validate": "newData.isString() && newData.val().matches(/^(f|h)$/)" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "mazal": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
            "cherche": { ".validate": "newData.isString() && newData.val().matches(/^(rencontre|amis|projet|saisPas)$/)" },
            "accueilFait": { ".validate": "newData.isBoolean()" },
            "age": { ".validate": "newData.isNumber() && newData.val() >= 18 && newData.val() <= 99" },
            "enfSouhait": { ".validate": "newData.isString() && newData.val().matches(/^(oui|non|ouvert)$/)" },
            "enfA": { ".validate": "newData.isString() && newData.val().matches(/^(oui|non)$/)" },
            "enfAccepte": { ".validate": "newData.isString() && newData.val().matches(/^(oui|non|egal)$/)" },
            "chabbat": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "cachere": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "enfants": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4" },
            "arriveA": { ".validate": "newData.isNumber()" },
            "$autre": { ".validate": false }
          }
        },

        "suggestions": {
          "$badge": {
            ".validate": "$badge.matches(/^[0-9]{1,4}$/)",
            "qId": { ".validate": "newData.isNumber()" },
            "liste": {
              "$i": {
                "n": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999" },
                "mz": { ".validate": "newData.isBoolean()" },
                "$autre": { ".validate": false }
              }
            },
            "$autre": { ".validate": false }
          }
        },

        "dejaSuggere": {
          "$badge": {
            ".validate": "$badge.matches(/^[0-9]{1,4}$/)",
            "$autre": { ".validate": "$autre.matches(/^[0-9]{1,4}$/) && newData.isBoolean()" }
          }
        },

        "rencontres": {
          "$badge": {
            ".validate": "$badge.matches(/^[0-9]{1,4}$/)",
            "$autre": { ".validate": "$autre.matches(/^[0-9]{1,4}$/) && newData.isBoolean()" }
          }
        },

        "reponses": {
          "$qId": {
            "$badge": {
              ".validate": "$badge.matches(/^[0-9]{1,4}$/)",
              "coin": { ".validate": "newData.isString() && (newData.val() == 'א' || newData.val() == 'ב' || newData.val() == 'ג' || newData.val() == 'ד')" },
              "at": { ".validate": "newData.isNumber()" },
              "$autre": { ".validate": false }
            }
          }
        },

        "prets": {
          "$qId": {
            "$badge": { ".validate": "$badge.matches(/^[0-9]{1,4}$/) && newData.isBoolean()" }
          }
        },

        "carrousel": {
          "ordre": {
            "$i": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999" }
          },
          "rotation": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "dejaVues": {
            "$paire": { ".validate": "$paire.matches(/^[0-9]{1,4}-[0-9]{1,4}$/) && newData.isBoolean()" }
          },
          "$autre": { ".validate": false }
        },

        "rdv": {
          "$badge": {
            ".validate": "$badge.matches(/^[0-9]{1,4}$/)",
            "tour": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
            "avec": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999" },
            "coin": { ".validate": "newData.isString() && (newData.val() == 'א' || newData.val() == 'ב' || newData.val() == 'ג' || newData.val() == 'ד')" },
            "$autre": { ".validate": false }
          }
        },

        "$autre": { ".validate": false }
      }
    }
  }
}
